# Canonical site origin for hreflang/canonical URLs — set to the production domain on deploy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form relay (server-side; real values to be added later) ---
# Telegram bot relay
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email relay destination + SMTP transport
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- How-to-help forms (volunteer/partnership) ---
# Web3Forms access key bound to support@newlife.foundation. The key is
# public/client-side by design; with a placeholder the forms render but
# log a console warning on submit and nothing is delivered.
NEXT_PUBLIC_WEB3FORMS_KEY=

# --- Donate page payment links (v1: plain external links) ---
NEXT_PUBLIC_MONO_JAR_URL=
NEXT_PUBLIC_LIQPAY_URL=
NEXT_PUBLIC_PAYPAL_URL=

# Canonical site origin for hreflang/canonical URLs — set to the production domain on deploy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Form relay (server-side; contact + volunteer + partner forms) ---
# All three forms deliver via the foundation's own Telegram bot and SMTP;
# a request succeeds if at least one channel delivers. Real values later.
# Telegram bot relay
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email relay destination + SMTP transport
CONTACT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Donate page payment links ---
# PayPal is integrated in-page (see src/lib/payments.ts — public ids, no env).
# These UAH links are optional: set a URL to flip the matching method from a
# "coming soon" stub to an active outbound link (Monobank jar / LiqPay).
NEXT_PUBLIC_MONO_JAR_URL=
NEXT_PUBLIC_LIQPAY_URL=
